{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "no-descending-specificity": null,
    "color-function-notation": null,
    "alpha-value-notation": null,
    "media-feature-range-notation": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "keyframes-name-pattern": null,
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": ["global"]
      }
    ],
    "declaration-property-value-disallowed-list": {
      "cursor": ["none"],
      "font-family": ["/Geist/", "/Brooklyn/", "/Instrument/", "/IBM Plex/", "/Poppins/"]
    }
  },
  "overrides": [
    {
      "files": ["src/**/*.module.css"],
      "rules": {
        "color-no-hex": [
          true,
          {
            "message": "Raw hex colors are prohibited in CSS modules. Use design tokens from src/app/globals.css (e.g., var(--void), var(--gold), var(--border))."
          }
        ]
      }
    }
  ],
  "ignoreFiles": ["node_modules/**", ".next/**", "studio-portfolio/**", "src/app/tailwind.css"]
}
