# ── Sanity Studio CMS ───────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# ── Studio Password Gate ────────────────────────────────────
STUDIO_ADMIN_EMAIL=admin@example.com
STUDIO_ADMIN_PASSWORD=your_secure_password
STUDIO_SESSION_SECRET=your_random_64_character_hex_string

# ── Supabase (Database & Future Admin / Bot) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key

# ── Resend Email Service & Contact Configuration ─────────────
RESEND_API_KEY=your_resend_api_key
CONTACT_NOTIFICATION_EMAIL=your_email@example.com
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Google Analytics 4 ───────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AI Chatbot (genious.exe) ─────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Telegram Live Chat Relay ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_for_webhook

# ── Cloudflare Turnstile (Bot Deterrent) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Web Push Notifications (Live Chat) ─────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:contact@genioussonu.me

