rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── The Lounge Realtime Hangout Security Rules ──
    match /rooms/{roomId} {
      // Any authenticated user (including Anonymous Auth) can read room state
      allow read: if request.auth != null;

      // Host creates the room initializing participantCount to 0
      allow create: if request.auth != null 
                    && request.resource.data.hostUid == request.auth.uid;

      // Authenticated users can update room state (host playback/metadata, participant joins/leaves)
      allow update: if request.auth != null;

      // Host can clean up room
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;

      // ── Participants Subcollection ──
      match /participants/{uid} {
        allow read: if request.auth != null;

        // Each participant manages only their own presence and status document
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // ── Messages Subcollection ──
      match /messages/{messageId} {
        allow read: if request.auth != null;
        
        // Chat messages: sender UID match, strict type check ('text' or 'sticker'), and sticker allowlist
        allow create: if request.auth != null 
                      && request.auth.uid == request.resource.data.uid
                      && request.resource.data.type in ['text', 'sticker']
                      && (
                        (request.resource.data.type == 'text'
                         && request.resource.data.text is string
                         && request.resource.data.text.trim().size() > 0
                         && request.resource.data.text.size() <= 1000)
                        ||
                        (request.resource.data.type == 'sticker'
                         && request.resource.data.stickerId in [
                           'cyber-rocket', 'fire-vibe', 'party-popper',
                           'cool-sunglasses', 'dj-headphones', 'glowing-heart'
                         ])
                      );
        
        // Chat messages are append-only
        allow update, delete: if false;
      }


      // ── WebRTC Signaling Subcollections (Screenshare Star & Voice Mesh) ──
      // Pairwise isolated documents: rooms/{roomId}/signals/{peerA}/peers/{peerB}
      match /signals/{peerA}/peers/{peerB} {
        allow read, write: if request.auth != null 
                           && (request.auth.uid == peerA || request.auth.uid == peerB);
      }

      match /voiceSignals/{peerA}/peers/{peerB} {
        allow read, write: if request.auth != null 
                           && (request.auth.uid == peerA || request.auth.uid == peerB);
      }
    }
  }
}
