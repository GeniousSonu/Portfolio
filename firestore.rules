rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── The Lounge Realtime Hangout Security Rules ──
    match /rooms/{roomId} {
      // Any authenticated user (including Anonymous Auth) can read room state
      allow read: if request.auth != null;

      // Host creates the room initializing participantCount to 0
      allow create: if request.auth != null 
                    && request.resource.data.hostUid == request.auth.uid;

      // Authenticated users can update room state (host playback/metadata, participant joins/leaves)
      allow update: if request.auth != null;

      // Host can clean up room
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostUid;

      // ── Participants Subcollection ──
      match /participants/{uid} {
        allow read: if request.auth != null;

        // Each participant manages only their own presence and status document
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // ── Messages Subcollection ──
      match /messages/{messageId} {
        allow read: if request.auth != null;
        
        // Chat messages: must be authenticated and sender UID must match
        allow create: if request.auth != null 
                      && request.auth.uid == request.resource.data.uid;
        
        // Chat messages are append-only
        allow update, delete: if false;
      }

      // ── Star-Topology WebRTC Signaling Subcollection ──
      // Isolated pairwise documents: rooms/{roomId}/signals/{presenterUid}/peers/{viewerUid}
      match /signals/{presenterUid}/peers/{viewerUid} {
        // Only the presenter and the specific viewer have read/write access to their pairwise negotiation doc
        allow read, write: if request.auth != null 
                           && (request.auth.uid == presenterUid || request.auth.uid == viewerUid);
      }
    }
  }
}
